{
  "name": "agent-log",
  "version": "1.0.0",
  "description": "Like git log, but for AI coding agents. Inspect raw trajectory transcripts, thinking tokens, and silent failures across machines.",
  "type": "module",
  "bin": {
    "agent-log": "./scripts/audit.mjs"
  },
  "scripts": {
    "log": "node scripts/audit.mjs --latest",
    "test": "node scripts/audit.mjs --latest --tail 5",
    "test:unit": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "agent-log",
    "ai-agents",
    "trajectory-forensics",
    "multi-agent",
    "antigravity",
    "claude-code",
    "codex",
    "vibe-coding",
    "agent-governance"
  ],
  "author": "Gabriel Toledo (https://github.com/Gabrielrtads)",
  "license": "MIT"
}
